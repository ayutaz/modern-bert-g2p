{"id": "hs-polyphone-013", "category": "polyphone", "text": "二人で歩く", "phonemes": ["f", "u", "t", "a", "r", "i", "d", "e", "a", "r", "u", "k", "u"], "accent": ["L", "H", "H", "H", "L", "H", "L"], "accent_phrase_boundaries": [4], "notes": "二人=ふたり (2-people counter, 7 moras). Contrast hs-polyphone-014 (二人=ににん in 二人前). 二人 平板, 歩く 中高2."}
{"id": "hs-polyphone-014", "category": "polyphone", "text": "二人前を注文", "phonemes": ["n", "i", "n", "i", "N", "m", "a", "e", "w", "o", "ch", "u", "u", "m", "o", "N"], "accent": ["L", "H", "H", "H", "L", "L", "L", "H", "H", "H"], "accent_phrase_boundaries": [6], "notes": "二人=ににん (in 人前 compound counter, 10 moras). ににんまえ accent 4 中高. 注文 平板."}
{"id": "hs-polyphone-015", "category": "polyphone", "text": "明日会おう", "phonemes": ["a", "sh", "i", "t", "a", "a", "o", "u"], "accent": ["L", "H", "H", "L", "H", "L"], "accent_phrase_boundaries": [3], "notes": "明日=あした (colloquial, 6 moras). Contrast hs-polyphone-016 (明日=あす formal). 明日 尾高, 会おう accent 2."}
{"id": "hs-polyphone-016", "category": "polyphone", "text": "明日の会議", "phonemes": ["a", "s", "u", "n", "o", "k", "a", "i", "g", "i"], "accent": ["L", "H", "L", "H", "L", "L"], "accent_phrase_boundaries": [3], "notes": "明日=あす (formal reading, 6 moras). Same surface 明日 as hs-polyphone-015 but different reading. あす 尾高2, 会議 頭高1."}
{"id": "hs-polyphone-017", "category": "polyphone", "text": "大人になる", "phonemes": ["o", "t", "o", "n", "a", "n", "i", "n", "a", "r", "u"], "accent": ["L", "H", "H", "H", "L", "H"], "accent_phrase_boundaries": [4], "notes": "大人=おとな (common noun, 6 moras). Contrast hs-polyphone-018 (大人=おおにん in 大人数). おとな 平板."}
