{"id": "hs-polyphone-020", "category": "polyphone", "text": "心中事件", "phonemes": ["sh", "i", "N", "j", "u", "u", "j", "i", "k", "e", "N"], "accent": ["L", "H", "H", "H", "H", "L", "L"], "accent_phrase_boundaries": [4], "notes": "心中=しんじゅう (double-suicide literary/news, 7 moras). Same surface as hs-polyphone-019. 事件 頭高1."}
{"id": "hs-counter-004", "category": "counter", "text": "犬が1匹", "phonemes": ["i", "n", "u", "g", "a", "i", "q", "p", "i", "k", "i"], "accent": ["L", "H", "L", "H", "L", "L", "L"], "accent_phrase_boundaries": [3], "notes": "1匹=いっぴき (sokuon + p rendaku, 7 moras). Cf. hs-counter-002 3匹=さんびき (b rendaku), hs-counter-005 2匹=にひき (no rendaku)."}
{"id": "hs-counter-005", "category": "counter", "text": "猫が2匹", "phonemes": ["n", "e", "k", "o", "g", "a", "n", "i", "h", "i", "k", "i"], "accent": ["H", "L", "L", "H", "L", "L"], "accent_phrase_boundaries": [3], "notes": "2匹=にひき (no rendaku, no sokuon, 6 moras). Baseline case in counter series; contrast 1/3/6/8/10匹 which alter."}
